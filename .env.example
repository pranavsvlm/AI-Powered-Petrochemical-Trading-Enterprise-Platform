# Shared base environment variables. Copy to .env.local and fill in values.
# Never commit real secrets.

NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/navoasis

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App Ports
BACKEND_PORT=3000
PORTAL_PORT=3001
