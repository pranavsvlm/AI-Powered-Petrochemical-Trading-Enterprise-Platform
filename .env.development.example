# Development environment overrides. Copy to .env.development.local as needed.

NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/navoasis_dev
REDIS_URL=redis://localhost:6379

# Object storage — MinIO in dev, Cloudflare R2 in production (see docs/DOMAIN_MODEL_PHASE3.md §2)
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=navoasis-documents
