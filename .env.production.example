# Production environment overrides. Populate via your deployment secret manager.

NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL=
REDIS_URL=

# Production storage must use Cloudflare R2, not the dev MinIO defaults.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
