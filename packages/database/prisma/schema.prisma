// Prisma schema — centralized for the whole platform (apps/backend depends on this package).
// Phase 1: Identity, Tenancy & Access Control.
// Phase 2: Platform Backbone (Event Bus, Rules Engine, Workflow Engine, Notification Center).
// See docs/DOMAIN_MODEL_PHASE1.md and docs/DOMAIN_MODEL_PHASE2.md for ratified domain decisions.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────
// Company Management (doc 08)
// ─────────────────────────────────────────────────────────────────────────

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Company {
  id                  String        @id @default(uuid())
  companyCode         String        @unique @map("company_code")
  legalName           String        @map("legal_name")
  tradeName           String?       @map("trade_name")
  registrationNumber  String?       @unique @map("registration_number")
  taxNumber           String?       @map("tax_number")
  country             String
  timezone            String
  currency            String
  language             String       @default("en")
  status              CompanyStatus @default(PENDING)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  profile   CompanyProfile?
  settings  CompanySettings?
  features  CompanyFeature[]
  branches  Branch[]
  users     User[]
  departments Department[]
  teams     Team[]
  roles     Role[]
  policies  Policy[]
  approvalRules ApprovalRule[]
  auditLogs AuditLog[]
  documentFolders    DocumentFolder[]
  documentCategories DocumentCategory[]
  documentTags       DocumentTag[]
  documents          Document[]

  @@map("companies")
  // Phase 2 back-relations intentionally omitted (Prisma does not require the
  // opposite relation field to be declared on Company for the FK-only side
  // to compile); Event/Rule/Workflow/Notification models reference companyId
  // as a plain scalar column (no relation) since Company already has a very
  // large fan-out — see docs/DOMAIN_MODEL_PHASE2.md for the tenant-isolation
  // approach used instead (service-level scoping + tenant-extension).
}

model CompanyProfile {
  id                 String   @id @default(uuid())
  companyId          String   @unique @map("company_id")
  logo               String?
  favicon            String?
  colors             Json?
  emailSignature     String?  @map("email_signature")
  quotationTemplate  String?  @map("quotation_template")
  invoiceTemplate    String?  @map("invoice_template")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

model CompanySettings {
  id              String   @id @default(uuid())
  companyId       String   @unique @map("company_id")
  aiProvider      String?  @map("ai_provider")
  defaultCurrency String   @map("default_currency")
  dateFormat      String   @default("YYYY-MM-DD") @map("date_format")
  numberFormat    String   @default("1,234.56") @map("number_format")
  businessHours   Json?    @map("business_hours")
  approvalRules   Json?    @map("approval_rules")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model CompanyFeature {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  moduleName String   @map("module_name")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleName])
  @@map("company_features")
}

enum BranchType {
  HEADQUARTERS
  REGIONAL_OFFICE
  WAREHOUSE
  SALES_OFFICE
  MANUFACTURING_PLANT
}

model Branch {
  id             String     @id @default(uuid())
  companyId      String     @map("company_id")
  name           String
  type           BranchType
  addressLine1   String?    @map("address_line1")
  addressLine2   String?    @map("address_line2")
  city           String?
  state          String?
  country        String?
  postalCode     String?    @map("postal_code")
  businessHours  Json?      @map("business_hours")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("branches")
}

// ─────────────────────────────────────────────────────────────────────────
// User Management (doc 06)
// ─────────────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING_INVITATION
  ACTIVE
  SUSPENDED
  LOCKED
  ARCHIVED
}

model User {
  id             String     @id @default(uuid())
  companyId      String     @map("company_id")
  employeeCode   String?    @map("employee_code")
  firstName      String     @map("first_name")
  lastName       String     @map("last_name")
  email          String
  phone          String?
  avatar         String?
  passwordHash   String     @map("password_hash")
  status         UserStatus @default(PENDING_INVITATION)
  lastLogin      DateTime?  @map("last_login")
  timezone       String     @default("UTC")
  language       String     @default("en")
  failedLoginAttempts Int   @default(0) @map("failed_login_attempts")
  lockedUntil    DateTime?  @map("locked_until")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  managedDepartments Department[] @relation("DepartmentManager")
  roles           UserRole[]
  sessions        UserSession[]
  mfa             UserMfa[]
  passwordResets  PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  auditLogsAsActor AuditLog[] @relation("AuditActor")
  requestedApprovals ApprovalHistory[] @relation("ApprovalRequestedBy")
  decidedApprovals   ApprovalHistory[] @relation("ApprovalDecidedBy")
  ownedDocuments           Document[]
  uploadedDocumentVersions DocumentVersion[]
  documentPermissions      DocumentPermission[]
  documentApprovalsAsApprover DocumentApproval[]

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

model Department {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  managerId String?  @map("manager_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager User?    @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  teams   Team[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

model Team {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  departmentId String   @map("department_id")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, name])
  @@index([companyId])
  @@map("teams")
}

// ─────────────────────────────────────────────────────────────────────────
// Roles & Permissions (doc 07)
// ─────────────────────────────────────────────────────────────────────────

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  REJECT
  EXPORT
  IMPORT
  PRINT
  SHARE
  EXECUTE_AI
  MANAGE_SETTINGS
}

model Role {
  id            String   @id @default(uuid())
  companyId     String?  @map("company_id")
  name          String
  isSystemRole  Boolean  @default(false) @map("is_system_role")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]
  approvalRulesAsApprover ApprovalRule[]
  documentPermissions DocumentPermission[]
  documentApprovalsAsApproverRole DocumentApproval[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model PermissionGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  permissions Permission[]

  @@map("permission_groups")
}

model Permission {
  id      String            @id @default(uuid())
  code    String            @unique
  module  String
  action  PermissionAction
  groupId String?           @map("group_id")

  group PermissionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Policy {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  name       String
  definition Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("policies")
}

model ApprovalRule {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  name             String
  triggerCondition Json     @map("trigger_condition")
  approverRoleId   String   @map("approver_role_id")
  threshold        Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approverRole Role              @relation(fields: [approverRoleId], references: [id], onDelete: Restrict)
  history      ApprovalHistory[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("approval_rules")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalHistory {
  id             String         @id @default(uuid())
  approvalRuleId String         @map("approval_rule_id")
  requestedById  String         @map("requested_by")
  approvedById   String?        @map("approved_by")
  status         ApprovalStatus @default(PENDING)
  decidedAt      DateTime?      @map("decided_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  approvalRule ApprovalRule @relation(fields: [approvalRuleId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  approvedBy   User?        @relation("ApprovalDecidedBy", fields: [approvedById], references: [id])

  @@index([approvalRuleId])
  @@map("approval_history")
}

// ─────────────────────────────────────────────────────────────────────────
// Authentication & Security (doc 09)
// ─────────────────────────────────────────────────────────────────────────

model UserSession {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  device            String?
  browser           String?
  os                String?
  ipAddress         String?   @map("ip_address")
  country           String?
  loginTime         DateTime  @default(now()) @map("login_time")
  lastActivity      DateTime  @default(now()) @map("last_activity")
  refreshTokenHash  String    @map("refresh_token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

enum MfaMethod {
  TOTP
  EMAIL_OTP
}

model UserMfa {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  method            MfaMethod
  secretEncrypted   String?   @map("secret_encrypted")
  enabled           Boolean   @default(false)
  backupCodesHashed String[]  @map("backup_codes_hashed")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, method])
  @@map("user_mfa")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit Logging (docs 06/07/08/09)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  companyId   String?  @map("company_id")
  actorUserId String?  @map("actor_user_id")
  eventType   String   @map("event_type")
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actor   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// Event Bus (doc 28) — Phase 2
// ─────────────────────────────────────────────────────────────────────────

enum EventProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTERED
}

model Event {
  id             String   @id @default(uuid())
  eventType      String   @map("event_type")
  eventVersion   Int      @default(1) @map("event_version")
  companyId      String   @map("company_id")
  aggregateId    String?  @map("aggregate_id")
  timestamp      DateTime @default(now())
  source         String
  correlationId  String?  @map("correlation_id")
  payload        Json
  metadata       Json?
  streamMessageId String? @map("stream_message_id")
  status         EventProcessingStatus @default(PENDING)
  createdAt      DateTime @default(now()) @map("created_at")

  consumers  EventConsumer[]
  deadLetter DeadLetterEvent[]
  replays    EventReplay[] @relation("ReplaySourceEvent")
  audits     EventAudit[]

  @@index([companyId])
  @@index([eventType])
  @@index([correlationId])
  @@index([aggregateId])
  @@map("events")
}

model EventSubscription {
  id           String   @id @default(uuid())
  topic        String
  consumerGroup String  @map("consumer_group")
  handlerName  String   @map("handler_name")
  companyId    String?  @map("company_id")
  isActive     Boolean  @default(true) @map("is_active")
  maxRetries   Int      @default(5) @map("max_retries")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  consumers EventConsumer[]

  @@unique([topic, consumerGroup])
  @@map("event_subscriptions")
}

model EventConsumer {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  eventId        String   @map("event_id")
  status         EventProcessingStatus @default(PENDING)
  attempts       Int      @default(0)
  lastAttemptAt  DateTime? @map("last_attempt_at")
  processedAt    DateTime? @map("processed_at")
  lastError      String?  @map("last_error")
  processingTimeMs Int?   @map("processing_time_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  subscription EventSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventId])
  @@index([eventId])
  @@index([status])
  @@map("event_consumers")
}

model DeadLetterEvent {
  id            String   @id @default(uuid())
  eventId       String   @map("event_id")
  subscriptionId String? @map("subscription_id")
  reason        String
  attempts      Int
  lastError     String?  @map("last_error")
  retriedAt     DateTime? @map("retried_at")
  createdAt     DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("dead_letter_events")
}

model EventReplay {
  id            String   @id @default(uuid())
  sourceEventId String?  @map("source_event_id")
  filter        Json?
  requestedById String?  @map("requested_by")
  status        String   @default("PENDING")
  eventsReplayed Int     @default(0) @map("events_replayed")
  startedAt     DateTime @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")

  sourceEvent Event? @relation("ReplaySourceEvent", fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@map("event_replays")
}

model EventAudit {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  action    String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_audits")
}

// ─────────────────────────────────────────────────────────────────────────
// Business Rules Engine (doc 23) — Phase 2
// ─────────────────────────────────────────────────────────────────────────

enum RuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RuleActionType {
  ALLOW
  BLOCK
  WARN
  REQUEST_APPROVAL
  NOTIFY
  GENERATE_TASK
  EXECUTE_WORKFLOW
  CALL_AI
  CALL_API
}

model Rule {
  id          String     @id @default(uuid())
  companyId   String     @map("company_id")
  name        String
  module      String
  priority    Int        @default(0)
  status      RuleStatus @default(DRAFT)
  description String?
  effectiveFrom DateTime? @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  versions   RuleVersion[]
  groupLinks RuleGroupMember[]
  executions RuleExecution[]
  audits     RuleAudit[]

  @@index([companyId, module])
  @@index([status])
  @@map("rules")
}

model RuleVersion {
  id         String     @id @default(uuid())
  ruleId     String     @map("rule_id")
  version    Int
  status     RuleStatus @default(DRAFT)
  condition  Json
  action     Json
  publishedAt DateTime? @map("published_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  rule       Rule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  conditions RuleCondition[]
  actions    RuleAction[]

  @@unique([ruleId, version])
  @@map("rule_versions")
}

model RuleCondition {
  id            String   @id @default(uuid())
  ruleVersionId String   @map("rule_version_id")
  field         String
  operator      String
  value         Json
  createdAt     DateTime @default(now()) @map("created_at")

  ruleVersion RuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)

  @@index([ruleVersionId])
  @@map("rule_conditions")
}

model RuleAction {
  id            String         @id @default(uuid())
  ruleVersionId String         @map("rule_version_id")
  type          RuleActionType
  params        Json
  order         Int            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at")

  ruleVersion RuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)

  @@index([ruleVersionId])
  @@map("rule_actions")
}

model RuleGroup {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  members RuleGroupMember[]

  @@unique([companyId, name])
  @@map("rule_groups")
}

model RuleGroupMember {
  ruleGroupId String @map("rule_group_id")
  ruleId      String @map("rule_id")

  ruleGroup RuleGroup @relation(fields: [ruleGroupId], references: [id], onDelete: Cascade)
  rule      Rule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([ruleGroupId, ruleId])
  @@map("rule_group_members")
}

model RuleExecution {
  id           String   @id @default(uuid())
  ruleId       String   @map("rule_id")
  companyId    String   @map("company_id")
  triggerContext Json   @map("trigger_context")
  decision     String
  actionsPerformed Json @map("actions_performed")
  durationMs   Int?     @map("duration_ms")
  isSimulation Boolean  @default(false) @map("is_simulation")
  createdAt    DateTime @default(now()) @map("created_at")

  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  documentApprovals DocumentApproval[]

  @@index([companyId])
  @@index([ruleId])
  @@map("rule_executions")
}

model RuleAudit {
  id        String   @id @default(uuid())
  ruleId    String   @map("rule_id")
  action    String
  actorUserId String? @map("actor_user_id")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("rule_audits")
}

// ─────────────────────────────────────────────────────────────────────────
// Workflow Engine (doc 22) — Phase 2
// ─────────────────────────────────────────────────────────────────────────

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowNodeType {
  START
  AI_DECISION
  CONDITION
  APPROVAL
  TASK
  NOTIFICATION
  API
  DOCUMENT
  DATABASE
  DELAY
  END
}

enum WorkflowExecutionStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

model Workflow {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  name        String
  description String?
  status      WorkflowStatus @default(DRAFT)
  triggerType String         @map("trigger_type")
  triggerConfig Json?        @map("trigger_config")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  versions   WorkflowVersion[]
  executions WorkflowExecution[]
  audits     WorkflowAudit[]

  @@index([companyId])
  @@map("workflows")
}

model WorkflowVersion {
  id         String         @id @default(uuid())
  workflowId String         @map("workflow_id")
  version    Int
  status     WorkflowStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  workflow Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodes    WorkflowNode[]
  edges    WorkflowEdge[]

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

model WorkflowNode {
  id               String           @id @default(uuid())
  workflowVersionId String          @map("workflow_version_id")
  key              String
  type             WorkflowNodeType
  name             String
  config           Json
  positionX        Float?           @map("position_x")
  positionY        Float?           @map("position_y")

  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  edgesFrom       WorkflowEdge[]  @relation("EdgeFrom")
  edgesTo         WorkflowEdge[]  @relation("EdgeTo")
  tasks           WorkflowTask[]
  approvals       WorkflowApproval[]

  @@unique([workflowVersionId, key])
  @@map("workflow_nodes")
}

model WorkflowEdge {
  id               String   @id @default(uuid())
  workflowVersionId String  @map("workflow_version_id")
  fromNodeId       String   @map("from_node_id")
  toNodeId         String   @map("to_node_id")
  condition        Json?

  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  fromNode        WorkflowNode    @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode          WorkflowNode    @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@index([workflowVersionId])
  @@map("workflow_edges")
}

model WorkflowExecution {
  id            String                  @id @default(uuid())
  workflowId    String                  @map("workflow_id")
  companyId     String                  @map("company_id")
  status        WorkflowExecutionStatus @default(RUNNING)
  currentNodeId String?                 @map("current_node_id")
  context       Json
  isSimulation  Boolean                 @default(false) @map("is_simulation")
  resumeAt      DateTime?               @map("resume_at")
  startedAt     DateTime                @default(now()) @map("started_at")
  completedAt   DateTime?               @map("completed_at")
  error         String?

  workflow  Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tasks     WorkflowTask[]
  approvals WorkflowApproval[]

  @@index([companyId])
  @@index([workflowId])
  @@index([status])
  @@map("workflow_executions")
}

model WorkflowTask {
  id            String    @id @default(uuid())
  executionId   String    @map("execution_id")
  nodeId        String    @map("node_id")
  assigneeUserId String?  @map("assignee_user_id")
  assigneeTeamId String?  @map("assignee_team_id")
  title         String
  status        String    @default("PENDING")
  dueDate       DateTime? @map("due_date")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  node      WorkflowNode      @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("workflow_tasks")
}

model WorkflowApproval {
  id            String    @id @default(uuid())
  executionId   String    @map("execution_id")
  nodeId        String    @map("node_id")
  approverUserId String?  @map("approver_user_id")
  approverRoleId String?  @map("approver_role_id")
  level         Int       @default(1)
  status        String    @default("PENDING")
  decidedAt     DateTime? @map("decided_at")
  comment       String?
  createdAt     DateTime  @default(now()) @map("created_at")

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  node      WorkflowNode      @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("workflow_approvals")
}

model WorkflowTemplate {
  id          String   @id @default(uuid())
  companyId   String?  @map("company_id")
  name        String
  category    String?
  definition  Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("workflow_templates")
}

model WorkflowAudit {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  action     String
  actorUserId String? @map("actor_user_id")
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_audits")
}

// ─────────────────────────────────────────────────────────────────────────
// Notification Center (doc 24) — Phase 2
// ─────────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  EMAIL
  IN_APP
  WHATSAPP
  SMS
  PUSH
}

enum NotificationPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
  INFORMATIONAL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

model Notification {
  id          String               @id @default(uuid())
  companyId   String               @map("company_id")
  recipientUserId String           @map("recipient_user_id")
  title       String
  body        String
  category    String
  priority    NotificationPriority @default(NORMAL)
  data        Json?
  readAt      DateTime?            @map("read_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  deliveries NotificationDelivery[]

  @@index([companyId, recipientUserId])
  @@index([readAt])
  @@map("notifications")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  companyId String?  @map("company_id")
  code      String
  channel   NotificationChannel
  subject   String?
  body      String
  variables Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, code, channel])
  @@map("notification_templates")
}

model NotificationPreference {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  channels      Json     @default("[\"EMAIL\",\"IN_APP\"]")
  quietHoursStart String? @map("quiet_hours_start")
  quietHoursEnd   String? @map("quiet_hours_end")
  language      String   @default("en")
  digestFrequency String @default("IMMEDIATE") @map("digest_frequency")
  categoryMutes Json?    @map("category_mutes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model NotificationDelivery {
  id             String                     @id @default(uuid())
  notificationId String                     @map("notification_id")
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  lastError      String?                    @map("last_error")
  sentAt         DateTime?                  @map("sent_at")
  deliveredAt    DateTime?                  @map("delivered_at")
  createdAt      DateTime                   @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_deliveries")
}

model NotificationGroup {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  memberUserIds Json @map("member_user_ids")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notification_groups")
}

model NotificationAudit {
  id        String   @id @default(uuid())
  notificationId String? @map("notification_id")
  action    String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([notificationId])
  @@map("notification_audits")
}

// ─────────────────────────────────────────────────────────────────────────
// Document Management (doc 21) — Phase 3
// See docs/DOMAIN_MODEL_PHASE3.md for the canonical storage-key convention, the OCR and
// vector-search seams, the approval-delegates-to-rules-engine decision, and the
// exact-hash-warn-not-block duplicate detection decision.
// ─────────────────────────────────────────────────────────────────────────

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
  DISPOSED
}

model DocumentFolder {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   DocumentFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children DocumentFolder[] @relation("FolderChildren")
  documents Document[]

  @@index([companyId])
  @@index([parentId])
  @@map("document_folders")
}

model DocumentCategory {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("document_categories")
}

model DocumentTag {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments DocumentTagAssignment[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("document_tags")
}

model DocumentTagAssignment {
  documentId String @map("document_id")
  tagId      String @map("tag_id")

  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      DocumentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("document_tag_assignments")
}

// `module` matches packages/storage's StorageModule union (finance/hr/products/quotations/
// contracts/trading/knowledge/company) — kept as a plain String here (not a Prisma enum)
// since packages/storage owns that list and duplicating it as a DB enum would let the two
// drift; validated at the application layer against STORAGE_MODULES.
model Document {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  folderId    String?        @map("folder_id")
  categoryId  String?        @map("category_id")
  module      String
  entityType  String         @map("entity_type")
  entityId    String?        @map("entity_id")
  title       String
  description String?
  status      DocumentStatus @default(DRAFT)
  retentionPolicyName  String?   @map("retention_policy_name")
  retentionExpiresAt   DateTime? @map("retention_expires_at")
  ownerUserId String         @map("owner_user_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Generated tsvector column (title + description), added via raw SQL in the Phase 3
  // migration since Prisma has no native tsvector type — see docs/DOMAIN_MODEL_PHASE3.md §5.
  // Declared `Unsupported` purely so `prisma db pull`/introspection stays accurate; the
  // Prisma Client never reads/writes it directly, only packages/search's raw $queryRaw does.
  searchVector Unsupported("tsvector")? @map("search_vector")

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  folder   DocumentFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  category DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  owner    User              @relation(fields: [ownerUserId], references: [id])

  versions    DocumentVersion[]
  tags        DocumentTagAssignment[]
  permissions DocumentPermission[]
  approvals   DocumentApproval[]
  audits      DocumentAudit[]
  embeddings  DocumentEmbedding[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, module])
  @@map("documents")
}

model DocumentVersion {
  id             String   @id @default(uuid())
  documentId     String   @map("document_id")
  version        Int
  storageKey     String   @map("storage_key")
  filename       String
  contentType    String   @map("content_type")
  sizeBytes      Int      @map("size_bytes")
  sha256Hash     String   @map("sha256_hash")
  uploadedByUserId String @map("uploaded_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedByUserId], references: [id])

  @@unique([documentId, version])
  @@index([documentId])
  @@index([sha256Hash])
  @@map("document_versions")
}

model DocumentPermission {
  id         String           @id @default(uuid())
  documentId String           @map("document_id")
  roleId     String?          @map("role_id")
  userId     String?          @map("user_id")
  action     PermissionAction
  grantedAt  DateTime         @default(now()) @map("granted_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role     Role?    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_permissions")
}

// Approval decisions are resolved by packages/rules-engine (RulesEngineClient.evaluateApproval),
// never reimplemented here — ruleExecutionId links back to the RuleExecution that produced the
// decision. See docs/DOMAIN_MODEL_PHASE3.md §6.
model DocumentApproval {
  id              String         @id @default(uuid())
  documentId      String         @map("document_id")
  ruleExecutionId String?        @map("rule_execution_id")
  status          ApprovalStatus @default(PENDING)
  approverUserId  String?        @map("approver_user_id")
  approverRoleId  String?        @map("approver_role_id")
  decidedAt       DateTime?      @map("decided_at")
  comment         String?
  createdAt       DateTime       @default(now()) @map("created_at")

  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ruleExecution RuleExecution? @relation(fields: [ruleExecutionId], references: [id], onDelete: SetNull)
  approverUser  User?          @relation(fields: [approverUserId], references: [id])
  approverRole  Role?          @relation(fields: [approverRoleId], references: [id])

  @@index([documentId])
  @@map("document_approvals")
}

model DocumentAudit {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  action      String
  actorUserId String?  @map("actor_user_id")
  detail      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_audits")
}

// Schema exists now (future-proofing), unused in Phase 3 — see docs/DOMAIN_MODEL_PHASE3.md §8.
// Wired up once packages/search's VectorSearchPort gets a real implementation.
model DocumentEmbedding {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  chunkIndex Int      @map("chunk_index")
  chunkText  String   @map("chunk_text")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_embeddings")
}
