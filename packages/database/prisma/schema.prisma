// Prisma schema — centralized for the whole platform (apps/backend depends on this package).
// Phase 1: Identity, Tenancy & Access Control.
// Phase 2: Platform Backbone (Event Bus, Rules Engine, Workflow Engine, Notification Center).
// Phase 3: Storage, Documents & Search.
// Phase 4: Core Trading Domain (Customers, Products, RFQ -> Quotation -> Order).
// Phase 5: Inventory, Procurement & Finance.
// Phase 6: AI Core & Agent Framework.
// See docs/DOMAIN_MODEL_PHASE{1,2,3,4,5,6}.md for ratified domain decisions.

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ─────────────────────────────────────────────────────────────────────────
// Company Management (doc 08)
// ─────────────────────────────────────────────────────────────────────────

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Company {
  id                  String        @id @default(uuid())
  companyCode         String        @unique @map("company_code")
  legalName           String        @map("legal_name")
  tradeName           String?       @map("trade_name")
  registrationNumber  String?       @unique @map("registration_number")
  taxNumber           String?       @map("tax_number")
  country             String
  timezone            String
  currency            String
  language             String       @default("en")
  status              CompanyStatus @default(PENDING)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  profile   CompanyProfile?
  settings  CompanySettings?
  features  CompanyFeature[]
  branches  Branch[]
  users     User[]
  departments Department[]
  teams     Team[]
  roles     Role[]
  policies  Policy[]
  approvalRules ApprovalRule[]
  auditLogs AuditLog[]
  documentFolders    DocumentFolder[]
  documentCategories DocumentCategory[]
  documentTags       DocumentTag[]
  documents          Document[]
  customers          Customer[]
  categories         Category[]
  products           Product[]
  productAttributes  ProductAttribute[]
  priceLists         PriceList[]
  rfqs               Rfq[]
  quotations         Quotation[]
  orders             Order[]
  approvalRequests   ApprovalRequest[]
  warehouses         Warehouse[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  stockReservations  StockReservation[]
  stockAdjustments   StockAdjustment[]
  suppliers          Supplier[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  chartOfAccounts    ChartOfAccount[]
  journals           Journal[]
  invoices           Invoice[]
  payments           Payment[]
  supplierBills      SupplierBill[]
  aiProviderConfigs  AiProviderConfig[]
  aiUsageRecords     AiUsageRecord[]
  promptTemplates    PromptTemplate[]
  agentExecutions    AgentExecution[]
  conversations      Conversation[]
  memories           Memory[]

  @@map("companies")
  // Phase 2 back-relations intentionally omitted (Prisma does not require the
  // opposite relation field to be declared on Company for the FK-only side
  // to compile); Event/Rule/Workflow/Notification models reference companyId
  // as a plain scalar column (no relation) since Company already has a very
  // large fan-out — see docs/DOMAIN_MODEL_PHASE2.md for the tenant-isolation
  // approach used instead (service-level scoping + tenant-extension).
}

model CompanyProfile {
  id                 String   @id @default(uuid())
  companyId          String   @unique @map("company_id")
  logo               String?
  favicon            String?
  colors             Json?
  emailSignature     String?  @map("email_signature")
  quotationTemplate  String?  @map("quotation_template")
  invoiceTemplate    String?  @map("invoice_template")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

model CompanySettings {
  id              String   @id @default(uuid())
  companyId       String   @unique @map("company_id")
  aiProvider      String?  @map("ai_provider")
  defaultCurrency String   @map("default_currency")
  dateFormat      String   @default("YYYY-MM-DD") @map("date_format")
  numberFormat    String   @default("1,234.56") @map("number_format")
  businessHours   Json?    @map("business_hours")
  approvalRules   Json?    @map("approval_rules")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model CompanyFeature {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  moduleName String   @map("module_name")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleName])
  @@map("company_features")
}

enum BranchType {
  HEADQUARTERS
  REGIONAL_OFFICE
  WAREHOUSE
  SALES_OFFICE
  MANUFACTURING_PLANT
}

model Branch {
  id             String     @id @default(uuid())
  companyId      String     @map("company_id")
  name           String
  type           BranchType
  addressLine1   String?    @map("address_line1")
  addressLine2   String?    @map("address_line2")
  city           String?
  state          String?
  country        String?
  postalCode     String?    @map("postal_code")
  businessHours  Json?      @map("business_hours")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouses Warehouse[]

  @@index([companyId])
  @@map("branches")
}

// ─────────────────────────────────────────────────────────────────────────
// User Management (doc 06)
// ─────────────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING_INVITATION
  ACTIVE
  SUSPENDED
  LOCKED
  ARCHIVED
}

model User {
  id             String     @id @default(uuid())
  companyId      String     @map("company_id")
  employeeCode   String?    @map("employee_code")
  firstName      String     @map("first_name")
  lastName       String     @map("last_name")
  email          String
  phone          String?
  avatar         String?
  passwordHash   String     @map("password_hash")
  status         UserStatus @default(PENDING_INVITATION)
  lastLogin      DateTime?  @map("last_login")
  timezone       String     @default("UTC")
  language       String     @default("en")
  failedLoginAttempts Int   @default(0) @map("failed_login_attempts")
  lockedUntil    DateTime?  @map("locked_until")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  managedDepartments Department[] @relation("DepartmentManager")
  roles           UserRole[]
  sessions        UserSession[]
  mfa             UserMfa[]
  passwordResets  PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  auditLogsAsActor AuditLog[] @relation("AuditActor")
  requestedApprovals ApprovalHistory[] @relation("ApprovalRequestedBy")
  decidedApprovals   ApprovalHistory[] @relation("ApprovalDecidedBy")
  ownedDocuments           Document[]
  uploadedDocumentVersions DocumentVersion[]
  documentPermissions      DocumentPermission[]
  documentApprovalsAsApprover DocumentApproval[]

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

model Department {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  managerId String?  @map("manager_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager User?    @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  teams   Team[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

model Team {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  departmentId String   @map("department_id")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, name])
  @@index([companyId])
  @@map("teams")
}

// ─────────────────────────────────────────────────────────────────────────
// Roles & Permissions (doc 07)
// ─────────────────────────────────────────────────────────────────────────

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  REJECT
  EXPORT
  IMPORT
  PRINT
  SHARE
  EXECUTE_AI
  MANAGE_SETTINGS
}

model Role {
  id            String   @id @default(uuid())
  companyId     String?  @map("company_id")
  name          String
  isSystemRole  Boolean  @default(false) @map("is_system_role")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]
  approvalRulesAsApprover ApprovalRule[]
  documentPermissions DocumentPermission[]
  documentApprovalsAsApproverRole DocumentApproval[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model PermissionGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  permissions Permission[]

  @@map("permission_groups")
}

model Permission {
  id      String            @id @default(uuid())
  code    String            @unique
  module  String
  action  PermissionAction
  groupId String?           @map("group_id")

  group PermissionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Policy {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  name       String
  definition Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("policies")
}

model ApprovalRule {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  name             String
  triggerCondition Json     @map("trigger_condition")
  approverRoleId   String   @map("approver_role_id")
  threshold        Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approverRole Role              @relation(fields: [approverRoleId], references: [id], onDelete: Restrict)
  history      ApprovalHistory[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("approval_rules")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalHistory {
  id             String         @id @default(uuid())
  approvalRuleId String         @map("approval_rule_id")
  requestedById  String         @map("requested_by")
  approvedById   String?        @map("approved_by")
  status         ApprovalStatus @default(PENDING)
  decidedAt      DateTime?      @map("decided_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  approvalRule ApprovalRule @relation(fields: [approvalRuleId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  approvedBy   User?        @relation("ApprovalDecidedBy", fields: [approvedById], references: [id])

  @@index([approvalRuleId])
  @@map("approval_history")
}

// ─────────────────────────────────────────────────────────────────────────
// Authentication & Security (doc 09)
// ─────────────────────────────────────────────────────────────────────────

model UserSession {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  device            String?
  browser           String?
  os                String?
  ipAddress         String?   @map("ip_address")
  country           String?
  loginTime         DateTime  @default(now()) @map("login_time")
  lastActivity      DateTime  @default(now()) @map("last_activity")
  refreshTokenHash  String    @map("refresh_token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

enum MfaMethod {
  TOTP
  EMAIL_OTP
}

model UserMfa {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  method            MfaMethod
  secretEncrypted   String?   @map("secret_encrypted")
  enabled           Boolean   @default(false)
  backupCodesHashed String[]  @map("backup_codes_hashed")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, method])
  @@map("user_mfa")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit Logging (docs 06/07/08/09)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  companyId   String?  @map("company_id")
  actorUserId String?  @map("actor_user_id")
  eventType   String   @map("event_type")
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actor   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// Event Bus (doc 28) — Phase 2
// ─────────────────────────────────────────────────────────────────────────

enum EventProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTERED
}

model Event {
  id             String   @id @default(uuid())
  eventType      String   @map("event_type")
  eventVersion   Int      @default(1) @map("event_version")
  companyId      String   @map("company_id")
  aggregateId    String?  @map("aggregate_id")
  timestamp      DateTime @default(now())
  source         String
  correlationId  String?  @map("correlation_id")
  payload        Json
  metadata       Json?
  streamMessageId String? @map("stream_message_id")
  status         EventProcessingStatus @default(PENDING)
  createdAt      DateTime @default(now()) @map("created_at")

  consumers  EventConsumer[]
  deadLetter DeadLetterEvent[]
  replays    EventReplay[] @relation("ReplaySourceEvent")
  audits     EventAudit[]

  @@index([companyId])
  @@index([eventType])
  @@index([correlationId])
  @@index([aggregateId])
  @@map("events")
}

model EventSubscription {
  id           String   @id @default(uuid())
  topic        String
  consumerGroup String  @map("consumer_group")
  handlerName  String   @map("handler_name")
  companyId    String?  @map("company_id")
  isActive     Boolean  @default(true) @map("is_active")
  maxRetries   Int      @default(5) @map("max_retries")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  consumers EventConsumer[]

  @@unique([topic, consumerGroup])
  @@map("event_subscriptions")
}

model EventConsumer {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  eventId        String   @map("event_id")
  status         EventProcessingStatus @default(PENDING)
  attempts       Int      @default(0)
  lastAttemptAt  DateTime? @map("last_attempt_at")
  processedAt    DateTime? @map("processed_at")
  lastError      String?  @map("last_error")
  processingTimeMs Int?   @map("processing_time_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  subscription EventSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventId])
  @@index([eventId])
  @@index([status])
  @@map("event_consumers")
}

model DeadLetterEvent {
  id            String   @id @default(uuid())
  eventId       String   @map("event_id")
  subscriptionId String? @map("subscription_id")
  reason        String
  attempts      Int
  lastError     String?  @map("last_error")
  retriedAt     DateTime? @map("retried_at")
  createdAt     DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("dead_letter_events")
}

model EventReplay {
  id            String   @id @default(uuid())
  sourceEventId String?  @map("source_event_id")
  filter        Json?
  requestedById String?  @map("requested_by")
  status        String   @default("PENDING")
  eventsReplayed Int     @default(0) @map("events_replayed")
  startedAt     DateTime @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")

  sourceEvent Event? @relation("ReplaySourceEvent", fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@map("event_replays")
}

model EventAudit {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  action    String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_audits")
}

// ─────────────────────────────────────────────────────────────────────────
// Business Rules Engine (doc 23) — Phase 2
// ─────────────────────────────────────────────────────────────────────────

enum RuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RuleActionType {
  ALLOW
  BLOCK
  WARN
  REQUEST_APPROVAL
  NOTIFY
  GENERATE_TASK
  EXECUTE_WORKFLOW
  CALL_AI
  CALL_API
}

model Rule {
  id          String     @id @default(uuid())
  companyId   String     @map("company_id")
  name        String
  module      String
  priority    Int        @default(0)
  status      RuleStatus @default(DRAFT)
  description String?
  effectiveFrom DateTime? @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  versions   RuleVersion[]
  groupLinks RuleGroupMember[]
  executions RuleExecution[]
  audits     RuleAudit[]

  @@index([companyId, module])
  @@index([status])
  @@map("rules")
}

model RuleVersion {
  id         String     @id @default(uuid())
  ruleId     String     @map("rule_id")
  version    Int
  status     RuleStatus @default(DRAFT)
  condition  Json
  action     Json
  publishedAt DateTime? @map("published_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  rule       Rule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  conditions RuleCondition[]
  actions    RuleAction[]

  @@unique([ruleId, version])
  @@map("rule_versions")
}

model RuleCondition {
  id            String   @id @default(uuid())
  ruleVersionId String   @map("rule_version_id")
  field         String
  operator      String
  value         Json
  createdAt     DateTime @default(now()) @map("created_at")

  ruleVersion RuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)

  @@index([ruleVersionId])
  @@map("rule_conditions")
}

model RuleAction {
  id            String         @id @default(uuid())
  ruleVersionId String         @map("rule_version_id")
  type          RuleActionType
  params        Json
  order         Int            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at")

  ruleVersion RuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)

  @@index([ruleVersionId])
  @@map("rule_actions")
}

model RuleGroup {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  members RuleGroupMember[]

  @@unique([companyId, name])
  @@map("rule_groups")
}

model RuleGroupMember {
  ruleGroupId String @map("rule_group_id")
  ruleId      String @map("rule_id")

  ruleGroup RuleGroup @relation(fields: [ruleGroupId], references: [id], onDelete: Cascade)
  rule      Rule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([ruleGroupId, ruleId])
  @@map("rule_group_members")
}

model RuleExecution {
  id           String   @id @default(uuid())
  ruleId       String   @map("rule_id")
  companyId    String   @map("company_id")
  triggerContext Json   @map("trigger_context")
  decision     String
  actionsPerformed Json @map("actions_performed")
  durationMs   Int?     @map("duration_ms")
  isSimulation Boolean  @default(false) @map("is_simulation")
  createdAt    DateTime @default(now()) @map("created_at")

  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  documentApprovals DocumentApproval[]
  approvalRequests  ApprovalRequest[]

  @@index([companyId])
  @@index([ruleId])
  @@map("rule_executions")
}

model RuleAudit {
  id        String   @id @default(uuid())
  ruleId    String   @map("rule_id")
  action    String
  actorUserId String? @map("actor_user_id")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("rule_audits")
}

// ─────────────────────────────────────────────────────────────────────────
// Workflow Engine (doc 22) — Phase 2
// ─────────────────────────────────────────────────────────────────────────

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowNodeType {
  START
  AI_DECISION
  CONDITION
  APPROVAL
  TASK
  NOTIFICATION
  API
  DOCUMENT
  DATABASE
  DELAY
  END
}

enum WorkflowExecutionStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

model Workflow {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  name        String
  description String?
  status      WorkflowStatus @default(DRAFT)
  triggerType String         @map("trigger_type")
  triggerConfig Json?        @map("trigger_config")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  versions   WorkflowVersion[]
  executions WorkflowExecution[]
  audits     WorkflowAudit[]

  @@index([companyId])
  @@map("workflows")
}

model WorkflowVersion {
  id         String         @id @default(uuid())
  workflowId String         @map("workflow_id")
  version    Int
  status     WorkflowStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  workflow Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodes    WorkflowNode[]
  edges    WorkflowEdge[]

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

model WorkflowNode {
  id               String           @id @default(uuid())
  workflowVersionId String          @map("workflow_version_id")
  key              String
  type             WorkflowNodeType
  name             String
  config           Json
  positionX        Float?           @map("position_x")
  positionY        Float?           @map("position_y")

  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  edgesFrom       WorkflowEdge[]  @relation("EdgeFrom")
  edgesTo         WorkflowEdge[]  @relation("EdgeTo")
  tasks           WorkflowTask[]
  approvals       WorkflowApproval[]

  @@unique([workflowVersionId, key])
  @@map("workflow_nodes")
}

model WorkflowEdge {
  id               String   @id @default(uuid())
  workflowVersionId String  @map("workflow_version_id")
  fromNodeId       String   @map("from_node_id")
  toNodeId         String   @map("to_node_id")
  condition        Json?

  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  fromNode        WorkflowNode    @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode          WorkflowNode    @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@index([workflowVersionId])
  @@map("workflow_edges")
}

model WorkflowExecution {
  id            String                  @id @default(uuid())
  workflowId    String                  @map("workflow_id")
  companyId     String                  @map("company_id")
  status        WorkflowExecutionStatus @default(RUNNING)
  currentNodeId String?                 @map("current_node_id")
  context       Json
  isSimulation  Boolean                 @default(false) @map("is_simulation")
  resumeAt      DateTime?               @map("resume_at")
  startedAt     DateTime                @default(now()) @map("started_at")
  completedAt   DateTime?               @map("completed_at")
  error         String?

  workflow  Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tasks     WorkflowTask[]
  approvals WorkflowApproval[]

  @@index([companyId])
  @@index([workflowId])
  @@index([status])
  @@map("workflow_executions")
}

model WorkflowTask {
  id            String    @id @default(uuid())
  executionId   String    @map("execution_id")
  nodeId        String    @map("node_id")
  assigneeUserId String?  @map("assignee_user_id")
  assigneeTeamId String?  @map("assignee_team_id")
  title         String
  status        String    @default("PENDING")
  dueDate       DateTime? @map("due_date")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  node      WorkflowNode      @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("workflow_tasks")
}

model WorkflowApproval {
  id            String    @id @default(uuid())
  executionId   String    @map("execution_id")
  nodeId        String    @map("node_id")
  approverUserId String?  @map("approver_user_id")
  approverRoleId String?  @map("approver_role_id")
  level         Int       @default(1)
  status        String    @default("PENDING")
  decidedAt     DateTime? @map("decided_at")
  comment       String?
  createdAt     DateTime  @default(now()) @map("created_at")

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  node      WorkflowNode      @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("workflow_approvals")
}

model WorkflowTemplate {
  id          String   @id @default(uuid())
  companyId   String?  @map("company_id")
  name        String
  category    String?
  definition  Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("workflow_templates")
}

model WorkflowAudit {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  action     String
  actorUserId String? @map("actor_user_id")
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_audits")
}

// ─────────────────────────────────────────────────────────────────────────
// Notification Center (doc 24) — Phase 2
// ─────────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  EMAIL
  IN_APP
  WHATSAPP
  SMS
  PUSH
}

enum NotificationPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
  INFORMATIONAL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

model Notification {
  id          String               @id @default(uuid())
  companyId   String               @map("company_id")
  recipientUserId String           @map("recipient_user_id")
  title       String
  body        String
  category    String
  priority    NotificationPriority @default(NORMAL)
  data        Json?
  readAt      DateTime?            @map("read_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  deliveries NotificationDelivery[]

  @@index([companyId, recipientUserId])
  @@index([readAt])
  @@map("notifications")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  companyId String?  @map("company_id")
  code      String
  channel   NotificationChannel
  subject   String?
  body      String
  variables Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, code, channel])
  @@map("notification_templates")
}

model NotificationPreference {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  channels      Json     @default("[\"EMAIL\",\"IN_APP\"]")
  quietHoursStart String? @map("quiet_hours_start")
  quietHoursEnd   String? @map("quiet_hours_end")
  language      String   @default("en")
  digestFrequency String @default("IMMEDIATE") @map("digest_frequency")
  categoryMutes Json?    @map("category_mutes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model NotificationDelivery {
  id             String                     @id @default(uuid())
  notificationId String                     @map("notification_id")
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  lastError      String?                    @map("last_error")
  sentAt         DateTime?                  @map("sent_at")
  deliveredAt    DateTime?                  @map("delivered_at")
  createdAt      DateTime                   @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_deliveries")
}

model NotificationGroup {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  memberUserIds Json @map("member_user_ids")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notification_groups")
}

model NotificationAudit {
  id        String   @id @default(uuid())
  notificationId String? @map("notification_id")
  action    String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([notificationId])
  @@map("notification_audits")
}

// ─────────────────────────────────────────────────────────────────────────
// Document Management (doc 21) — Phase 3
// See docs/DOMAIN_MODEL_PHASE3.md for the canonical storage-key convention, the OCR and
// vector-search seams, the approval-delegates-to-rules-engine decision, and the
// exact-hash-warn-not-block duplicate detection decision.
// ─────────────────────────────────────────────────────────────────────────

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
  DISPOSED
}

model DocumentFolder {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   DocumentFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children DocumentFolder[] @relation("FolderChildren")
  documents Document[]

  @@index([companyId])
  @@index([parentId])
  @@map("document_folders")
}

model DocumentCategory {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("document_categories")
}

model DocumentTag {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments DocumentTagAssignment[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("document_tags")
}

model DocumentTagAssignment {
  documentId String @map("document_id")
  tagId      String @map("tag_id")

  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      DocumentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("document_tag_assignments")
}

// `module` matches packages/storage's StorageModule union (finance/hr/products/quotations/
// contracts/trading/knowledge/company) — kept as a plain String here (not a Prisma enum)
// since packages/storage owns that list and duplicating it as a DB enum would let the two
// drift; validated at the application layer against STORAGE_MODULES.
model Document {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  folderId    String?        @map("folder_id")
  categoryId  String?        @map("category_id")
  module      String
  entityType  String         @map("entity_type")
  entityId    String?        @map("entity_id")
  title       String
  description String?
  status      DocumentStatus @default(DRAFT)
  retentionPolicyName  String?   @map("retention_policy_name")
  retentionExpiresAt   DateTime? @map("retention_expires_at")
  ownerUserId String         @map("owner_user_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Generated tsvector column (title + description), added via raw SQL in the Phase 3
  // migration since Prisma has no native tsvector type — see docs/DOMAIN_MODEL_PHASE3.md §5.
  // Declared `Unsupported` purely so `prisma db pull`/introspection stays accurate; the
  // Prisma Client never reads/writes it directly, only packages/search's raw $queryRaw does.
  searchVector Unsupported("tsvector")? @map("search_vector")

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  folder   DocumentFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  category DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  owner    User              @relation(fields: [ownerUserId], references: [id])

  versions    DocumentVersion[]
  tags        DocumentTagAssignment[]
  permissions DocumentPermission[]
  approvals   DocumentApproval[]
  audits      DocumentAudit[]
  embeddings  DocumentEmbedding[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, module])
  @@map("documents")
}

model DocumentVersion {
  id             String   @id @default(uuid())
  documentId     String   @map("document_id")
  version        Int
  storageKey     String   @map("storage_key")
  filename       String
  contentType    String   @map("content_type")
  sizeBytes      Int      @map("size_bytes")
  sha256Hash     String   @map("sha256_hash")
  uploadedByUserId String @map("uploaded_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedByUserId], references: [id])

  @@unique([documentId, version])
  @@index([documentId])
  @@index([sha256Hash])
  @@map("document_versions")
}

model DocumentPermission {
  id         String           @id @default(uuid())
  documentId String           @map("document_id")
  roleId     String?          @map("role_id")
  userId     String?          @map("user_id")
  action     PermissionAction
  grantedAt  DateTime         @default(now()) @map("granted_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role     Role?    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_permissions")
}

// Approval decisions are resolved by packages/rules-engine (RulesEngineClient.evaluateApproval),
// never reimplemented here — ruleExecutionId links back to the RuleExecution that produced the
// decision. See docs/DOMAIN_MODEL_PHASE3.md §6.
model DocumentApproval {
  id              String         @id @default(uuid())
  documentId      String         @map("document_id")
  ruleExecutionId String?        @map("rule_execution_id")
  status          ApprovalStatus @default(PENDING)
  approverUserId  String?        @map("approver_user_id")
  approverRoleId  String?        @map("approver_role_id")
  decidedAt       DateTime?      @map("decided_at")
  comment         String?
  createdAt       DateTime       @default(now()) @map("created_at")

  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ruleExecution RuleExecution? @relation(fields: [ruleExecutionId], references: [id], onDelete: SetNull)
  approverUser  User?          @relation(fields: [approverUserId], references: [id])
  approverRole  Role?          @relation(fields: [approverRoleId], references: [id])

  @@index([documentId])
  @@map("document_approvals")
}

model DocumentAudit {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  action      String
  actorUserId String?  @map("actor_user_id")
  detail      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_audits")
}

// Schema exists now (future-proofing), unused in Phase 3 — see docs/DOMAIN_MODEL_PHASE3.md §8.
// Wired up once packages/search's VectorSearchPort gets a real implementation.
// Phase 6: the `embedding` column and `metadata` field are the schema completion
// docs/DOMAIN_MODEL_PHASE3.md §8 flagged as deferred ("schema exists, unused") — see
// docs/DOMAIN_MODEL_PHASE6.md §7 for why the column is a fixed vector(768) tied to one
// designated embedding model rather than part of the same per-company provider-swap surface
// chat completion gets.
model DocumentEmbedding {
  id         String                     @id @default(uuid())
  documentId String                     @map("document_id")
  chunkIndex Int                        @map("chunk_index")
  chunkText  String                     @map("chunk_text")
  metadata   Json?
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                   @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_embeddings")
}

// ─────────────────────────────────────────────────────────────────────────
// Core Trading Domain (docs 11/12/13) — Phase 4
// Customer Management, Product Information Management, and the RFQ -> Quotation -> Order
// state machine. See docs/DOMAIN_MODEL_PHASE4.md for the ratified state machines, the
// approval-gate wiring (delegated to RuleEvaluationService.evaluateApproval, never
// reimplemented — same law as docs/DOMAIN_MODEL_PHASE3.md §6), and the cross-module
// composition rule (Prisma FK relations are allowed cross-module since the schema is shared
// platform infrastructure; a module's Repository class is never imported by another module).
// ─────────────────────────────────────────────────────────────────────────

enum CustomerStatus {
  PROSPECT
  QUALIFIED_LEAD
  ACTIVE
  PENDING_APPROVAL
  ARCHIVED
}

enum CustomerType {
  DISTRIBUTOR
  END_USER
  TRADER
  MANUFACTURER
  OTHER
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
}

model Customer {
  id               String         @id @default(uuid())
  companyId        String         @map("company_id")
  customerCode     String         @map("customer_code")
  legalName        String         @map("legal_name")
  tradeName        String?        @map("trade_name")
  taxNumber        String?        @map("tax_number")
  country          String
  city             String?
  address          String?
  currency         String
  language         String?        @default("en")
  industry         String?
  website          String?
  status           CustomerStatus @default(PROSPECT)
  customerType     CustomerType?  @map("customer_type")
  segment          String?
  tags             String[]       @default([])
  creditLimit      Decimal?       @map("credit_limit")
  paymentTermsDays Int?           @map("payment_terms_days")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contacts   Contact[]
  activities CustomerActivity[]
  priceLists PriceList[]
  rfqs       Rfq[]
  quotations Quotation[]
  orders     Order[]

  @@unique([companyId, customerCode])
  @@index([companyId, status])
  @@map("customers")
}

model Contact {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  email      String?
  phone      String?
  jobTitle   String?  @map("job_title")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("contacts")
}

model CustomerActivity {
  id           String       @id @default(uuid())
  customerId   String       @map("customer_id")
  type         ActivityType
  body         String
  authorUserId String       @map("author_user_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_activities")
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  DISCONTINUED
  ARCHIVED
}

enum AttributeDataType {
  STRING
  NUMBER
  BOOLEAN
  DATE
}

enum PackagingType {
  DRUM
  IBC
  FLEXIBAG
  ISO_TANK
  TANK_TRUCK
  BULK_VESSEL
  BAG
  PAIL
  CUSTOM
}

enum UnitOfMeasure {
  MT
  KG
  LITER
  GALLON
  BARREL
  CUBIC_METER
  PIECE
}

enum PriceType {
  BASE
  CUSTOMER_SPECIFIC
  CONTRACT
  PROMOTIONAL
  QUANTITY_BREAK
  REGION
}

// Collapses doc 12's 7-level Business Unit -> Category -> SubCategory -> Product Family tree
// into one self-referential table — see docs/DOMAIN_MODEL_PHASE4.md.
model Category {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryChildren")
  products Product[]

  @@index([companyId, parentId])
  @@map("categories")
}

// A Variant (doc 12) is a Product row pointing at its parent via parentProductId.
model Product {
  id              String        @id @default(uuid())
  companyId       String        @map("company_id")
  sku             String
  productCode     String?       @map("product_code")
  name            String
  categoryId      String?       @map("category_id")
  parentProductId String?       @map("parent_product_id")
  brand           String?
  manufacturer    String?
  countryOfOrigin String?       @map("country_of_origin")
  hsCode          String?       @map("hs_code")
  casNumber       String?       @map("cas_number")
  unNumber        String?       @map("un_number")
  description     String?
  baseUom         UnitOfMeasure @map("base_uom")
  standardCost    Decimal?      @map("standard_cost")
  status          ProductStatus @default(DRAFT)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parentProduct Product?  @relation("ProductVariants", fields: [parentProductId], references: [id], onDelete: SetNull)
  variants      Product[] @relation("ProductVariants")

  attributeValues    ProductAttributeValue[]
  packaging          ProductPackaging[]
  priceLists         PriceList[]
  rfqLineItems       RfqLineItem[]
  quotationLineItems QuotationLineItem[]
  orderLineItems     OrderLineItem[]
  inventoryItems     InventoryItem[]
  purchaseRequisitionItems PurchaseRequisitionItem[]
  purchaseOrderItems PurchaseOrderItem[]
  invoiceItems       InvoiceItem[]

  @@unique([companyId, sku])
  @@index([companyId, status])
  @@index([companyId, categoryId])
  @@map("products")
}

// EAV pattern per doc 12: "companies may create unlimited attributes without code changes."
model ProductAttribute {
  id        String            @id @default(uuid())
  companyId String            @map("company_id")
  name      String
  dataType  AttributeDataType @map("data_type")
  unit      String?
  createdAt DateTime          @default(now()) @map("created_at")

  company Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  values  ProductAttributeValue[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("product_attributes")
}

model ProductAttributeValue {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  attributeId String   @map("attribute_id")
  value       String
  // Numeric shadow column so numeric-typed attributes (Density, Viscosity, Flash Point) can
  // be range-queried without parsing the string `value` column at read time.
  valueNumber Decimal? @map("value_number")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([attributeId, valueNumber])
  @@map("product_attribute_values")
}

model ProductPackaging {
  id              String         @id @default(uuid())
  productId       String         @map("product_id")
  packagingType   PackagingType  @map("packaging_type")
  unitsPerPackage Decimal?       @map("units_per_package")
  uom             UnitOfMeasure?
  createdAt       DateTime       @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, packagingType])
  @@map("product_packaging")
}

// customerId = null means a general (non-customer-specific) price list entry.
model PriceList {
  id          String        @id @default(uuid())
  companyId   String        @map("company_id")
  productId   String        @map("product_id")
  customerId  String?       @map("customer_id")
  priceType   PriceType     @default(BASE) @map("price_type")
  region      String?
  currency    String
  uom         UnitOfMeasure
  minQuantity Decimal       @default(0) @map("min_quantity")
  unitPrice   Decimal       @map("unit_price")
  validFrom   DateTime?     @map("valid_from")
  validTo     DateTime?     @map("valid_to")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId, productId, customerId])
  @@map("price_lists")
}

enum RfqStatus {
  DRAFT
  SUBMITTED
  QUOTED
  CLOSED
  CANCELLED
}

// No REJECTED value here, deliberately: rejection is recorded on ApprovalRequest.status (which
// already carries APPROVED/REJECTED), and a rejected Quotation reopens straight to NEGOTIATING
// — mirroring DocumentStatus, which likewise has no REJECTED value of its own. Keeping a
// parallel REJECTED status on the aggregate would duplicate state the approval record already
// owns, the exact "second approval system" pattern docs/DOMAIN_MODEL_PHASE3.md §6 forbids.
enum QuotationStatus {
  DRAFT
  SENT
  NEGOTIATING
  PENDING_APPROVAL
  APPROVED
  CONVERTED
  CANCELLED
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  ON_HOLD
  CLOSED
  CANCELLED
}

enum Incoterm {
  FOB
  CIF
  CFR
  EXW
  FCA
  DDP
  DAP
}

model Rfq {
  id              String    @id @default(uuid())
  companyId       String    @map("company_id")
  rfqNumber       String    @map("rfq_number")
  customerId      String    @map("customer_id")
  status          RfqStatus @default(DRAFT)
  currency        String
  notes           String?
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lineItems  RfqLineItem[]
  quotations Quotation[]

  @@unique([companyId, rfqNumber])
  @@index([companyId, status])
  @@map("rfqs")
}

model RfqLineItem {
  id          String        @id @default(uuid())
  rfqId       String        @map("rfq_id")
  productId   String        @map("product_id")
  quantity    Decimal
  uom         UnitOfMeasure
  targetPrice Decimal?      @map("target_price")
  createdAt   DateTime      @default(now()) @map("created_at")

  rfq     Rfq     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([rfqId])
  @@map("rfq_line_items")
}

// rfqId is nullable — a Quotation may be created directly, without a prior RFQ.
model Quotation {
  id                   String          @id @default(uuid())
  companyId            String          @map("company_id")
  quotationNumber      String          @map("quotation_number")
  rfqId                String?         @map("rfq_id")
  customerId           String          @map("customer_id")
  status               QuotationStatus @default(DRAFT)
  currency             String
  validUntil           DateTime?       @map("valid_until")
  // Denormalized from the current QuotationVersion for fast list/read without a join.
  currentVersionNumber Int             @default(1) @map("current_version_number")
  subtotal             Decimal         @default(0)
  discountAmount       Decimal         @default(0) @map("discount_amount")
  totalAmount          Decimal         @default(0) @map("total_amount")
  marginPercent        Decimal?        @map("margin_percent")
  createdByUserId      String          @map("created_by_user_id")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rfq      Rfq?               @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  customer Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  versions QuotationVersion[]
  orders   Order[]

  @@unique([companyId, quotationNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@map("quotations")
}

model QuotationVersion {
  id              String   @id @default(uuid())
  quotationId     String   @map("quotation_id")
  versionNumber   Int      @map("version_number")
  subtotal        Decimal  @default(0)
  discountAmount  Decimal  @default(0) @map("discount_amount")
  totalAmount     Decimal  @default(0) @map("total_amount")
  marginPercent   Decimal? @map("margin_percent")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  quotation Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  lineItems QuotationLineItem[]

  @@unique([quotationId, versionNumber])
  @@map("quotation_versions")
}

model QuotationLineItem {
  id                 String        @id @default(uuid())
  quotationVersionId String        @map("quotation_version_id")
  productId          String        @map("product_id")
  quantity           Decimal
  uom                UnitOfMeasure
  unitPrice          Decimal       @map("unit_price")
  discountPercent    Decimal       @default(0) @map("discount_percent")
  lineTotal          Decimal       @map("line_total")

  quotationVersion QuotationVersion @relation(fields: [quotationVersionId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationVersionId])
  @@map("quotation_line_items")
}

// Polymorphic across Customer/Quotation/Order (entityType/entityId) — mirrors
// DocumentApproval's shape exactly, including the RuleExecution link. Only ever *records* the
// outcome of RuleEvaluationService.evaluateApproval; never makes its own decision — see
// docs/DOMAIN_MODEL_PHASE3.md §6 and docs/DOMAIN_MODEL_PHASE4.md.
model ApprovalRequest {
  id              String         @id @default(uuid())
  companyId       String         @map("company_id")
  entityType      String         @map("entity_type")
  entityId        String         @map("entity_id")
  ruleExecutionId String?        @map("rule_execution_id")
  status          ApprovalStatus @default(PENDING)
  approverUserId  String?        @map("approver_user_id")
  approverRoleId  String?        @map("approver_role_id")
  decidedAt       DateTime?      @map("decided_at")
  comment         String?
  createdAt       DateTime       @default(now()) @map("created_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ruleExecution RuleExecution? @relation(fields: [ruleExecutionId], references: [id], onDelete: SetNull)

  @@index([companyId, entityType, entityId])
  @@map("approval_requests")
}

// quotationId is nullable — an Order may be created directly from a Customer (repeat-order
// fast path) without a prior Quotation.
model Order {
  id              String      @id @default(uuid())
  companyId       String      @map("company_id")
  orderNumber     String      @map("order_number")
  customerId      String      @map("customer_id")
  quotationId     String?     @map("quotation_id")
  status          OrderStatus @default(PENDING_CONFIRMATION)
  currency        String
  incoterm        Incoterm?
  subtotal        Decimal     @default(0)
  totalAmount     Decimal     @default(0) @map("total_amount")
  createdByUserId String      @map("created_by_user_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation Quotation?      @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  lineItems OrderLineItem[]
  reservations StockReservation[]
  invoice   Invoice?

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@map("orders")
}

// warehouseId is nullable at the schema level (a pre-Phase-5 order row would have none), but
// every Phase-5-created line item always resolves one (the caller's choice or the company's
// default warehouse) before the reservation step runs — see docs/DOMAIN_MODEL_PHASE5.md.
model OrderLineItem {
  id                String        @id @default(uuid())
  orderId           String        @map("order_id")
  productId         String        @map("product_id")
  warehouseId       String?       @map("warehouse_id")
  quantity          Decimal
  uom               UnitOfMeasure
  unitPrice         Decimal       @map("unit_price")
  lineTotal         Decimal       @map("line_total")
  fulfilledQuantity Decimal       @default(0) @map("fulfilled_quantity")

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  reservation StockReservation?

  @@index([orderId])
  @@map("order_line_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Inventory Management (doc 16) — Phase 5
// See docs/DOMAIN_MODEL_PHASE5.md for the ratified warehouse-hierarchy collapse, the atomic
// reservation primitive, and why InventoryMovement (unlike OrderLineItem/QuotationLineItem) is
// tenant-scoped in its own right rather than a pure child.
// ─────────────────────────────────────────────────────────────────────────

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

model Warehouse {
  id           String          @id @default(uuid())
  companyId    String          @map("company_id")
  branchId     String?         @map("branch_id")
  code         String
  name         String
  addressLine1 String?         @map("address_line1")
  city         String?
  country      String?
  isDefault    Boolean         @default(false) @map("is_default")
  status       WarehouseStatus @default(ACTIVE)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  inventoryItems InventoryItem[]
  orderLineItems OrderLineItem[]
  goodsReceipts  GoodsReceipt[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("warehouses")
}

model InventoryItem {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  productId        String   @map("product_id")
  warehouseId      String   @map("warehouse_id")
  quantityOnHand   Decimal  @default(0) @map("quantity_on_hand")
  quantityReserved Decimal  @default(0) @map("quantity_reserved")
  reorderPoint     Decimal? @map("reorder_point")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  batches      InventoryBatch[]
  movements    InventoryMovement[]
  reservations StockReservation[]
  adjustments  StockAdjustment[]

  @@unique([companyId, productId, warehouseId])
  @@index([companyId, warehouseId])
  @@map("inventory_items")
}

// Pure child of InventoryItem — batch/lot tracking (doc 16), created at goods-receipt time.
// COA/SDS/MSDS links reuse Document.entityType='inventoryBatch' polymorphism (Phase 3/4
// precedent), not new fields here.
model InventoryBatch {
  id              String    @id @default(uuid())
  inventoryItemId String    @map("inventory_item_id")
  batchNumber     String    @map("batch_number")
  quantity        Decimal
  expiryDate      DateTime? @map("expiry_date")
  receivedAt      DateTime  @default(now()) @map("received_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@map("inventory_batches")
}

// RECEIPT: goods receipt increases quantityOnHand. DISPATCH: stock permanently allocated away
// from available inventory at order-CONFIRMATION commit time (not physical warehouse dispatch,
// which stays OrderLineItem.fulfilledQuantity/fulfillLine() — see docs/DOMAIN_MODEL_PHASE5.md).
// ADJUSTMENT: manual StockAdjustment. RESERVATION_RELEASE: an ACTIVE reservation released
// without ever being committed (e.g. order cancelled). REVERSAL: the saga's compensating action
// undoing a DISPATCH when invoice generation fails after inventory was committed.
enum InventoryMovementType {
  RECEIPT
  DISPATCH
  ADJUSTMENT
  RESERVATION_RELEASE
  REVERSAL
}

// A real tenant-scoped aggregate (not a pure child like OrderLineItem) — an append-only ledger
// meant to be queried directly ("stock-card report for company X"), same shape as
// ApprovalRequest's polymorphic entityType/entityId. See docs/DOMAIN_MODEL_PHASE5.md.
model InventoryMovement {
  id              String                @id @default(uuid())
  companyId       String                @map("company_id")
  inventoryItemId String                @map("inventory_item_id")
  movementType    InventoryMovementType @map("movement_type")
  quantity        Decimal
  entityType      String                @map("entity_type")
  entityId        String?               @map("entity_id")
  note            String?
  createdAt       DateTime              @default(now()) @map("created_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([companyId, inventoryItemId])
  @@index([companyId, entityType, entityId])
  @@map("inventory_movements")
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  COMMITTED
}

// One reservation per order line item (no split/partial reservations in Phase 5) — the row the
// atomic conditional UPDATE in InventoryRepository.atomicReserve stamps directly.
model StockReservation {
  id              String                 @id @default(uuid())
  companyId       String                 @map("company_id")
  orderId         String                 @map("order_id")
  orderLineItemId String                 @unique @map("order_line_item_id")
  inventoryItemId String                 @map("inventory_item_id")
  quantity        Decimal
  status          StockReservationStatus @default(ACTIVE)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLineItem OrderLineItem @relation(fields: [orderLineItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([companyId, orderId])
  @@index([companyId, status])
  @@map("stock_reservations")
}

model StockAdjustment {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  inventoryItemId String   @map("inventory_item_id")
  quantityDelta   Decimal  @map("quantity_delta")
  reason          String
  actorUserId     String   @map("actor_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([companyId, inventoryItemId])
  @@map("stock_adjustments")
}

// ─────────────────────────────────────────────────────────────────────────
// Procurement Management (doc 17) — Phase 5
// See docs/DOMAIN_MODEL_PHASE5.md for the ratified scope — SupplierRFQ/SupplierQuotation,
// SupplierCertification, SupplierContract, and a standalone QualityInspection are deferred.
// ─────────────────────────────────────────────────────────────────────────

enum SupplierStatus {
  PROSPECT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Supplier {
  id               String         @id @default(uuid())
  companyId        String         @map("company_id")
  supplierCode     String         @map("supplier_code")
  legalName        String         @map("legal_name")
  tradeName        String?        @map("trade_name")
  taxNumber        String?        @map("tax_number")
  country          String
  city             String?
  address          String?
  currency         String
  paymentTermsDays Int?           @map("payment_terms_days")
  status           SupplierStatus @default(PROSPECT)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contacts       SupplierContact[]
  purchaseOrders PurchaseOrder[]
  supplierBills  SupplierBill[]

  @@unique([companyId, supplierCode])
  @@index([companyId, status])
  @@map("suppliers")
}

// Exact field-shape mirror of Phase 4's Customer + Contact.
model SupplierContact {
  id         String   @id @default(uuid())
  supplierId String   @map("supplier_id")
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  email      String?
  phone      String?
  jobTitle   String?  @map("job_title")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_contacts")
}

enum PurchaseRequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

model PurchaseRequisition {
  id                String                    @id @default(uuid())
  companyId         String                    @map("company_id")
  requisitionNumber String                    @map("requisition_number")
  requestedByUserId String                    @map("requested_by_user_id")
  status            PurchaseRequisitionStatus @default(DRAFT)
  notes             String?
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lineItems      PurchaseRequisitionItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, requisitionNumber])
  @@index([companyId, status])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id                 String        @id @default(uuid())
  requisitionId      String        @map("requisition_id")
  productId          String        @map("product_id")
  quantity           Decimal
  uom                UnitOfMeasure
  estimatedUnitPrice Decimal?      @map("estimated_unit_price")

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([requisitionId])
  @@map("purchase_requisition_items")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

// requisitionId is nullable — a PO may be created directly, without a prior Requisition,
// mirroring Order.quotationId's precedent.
model PurchaseOrder {
  id              String              @id @default(uuid())
  companyId       String              @map("company_id")
  poNumber        String              @map("po_number")
  supplierId      String              @map("supplier_id")
  requisitionId   String?             @map("requisition_id")
  status          PurchaseOrderStatus @default(DRAFT)
  currency        String
  subtotal        Decimal             @default(0)
  totalAmount     Decimal             @default(0) @map("total_amount")
  createdByUserId String              @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  requisition   PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  lineItems     PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  supplierBills SupplierBill[]

  @@unique([companyId, poNumber])
  @@index([companyId, status])
  @@index([companyId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String        @map("purchase_order_id")
  productId        String        @map("product_id")
  quantity         Decimal
  uom              UnitOfMeasure
  unitPrice        Decimal       @map("unit_price")
  lineTotal        Decimal       @map("line_total")
  receivedQuantity Decimal       @default(0) @map("received_quantity")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  goodsReceiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

enum GoodsReceiptStatus {
  DRAFT
  COMPLETED
}

model GoodsReceipt {
  id               String             @id @default(uuid())
  companyId        String             @map("company_id")
  receiptNumber    String             @map("receipt_number")
  purchaseOrderId  String             @map("purchase_order_id")
  warehouseId      String             @map("warehouse_id")
  status           GoodsReceiptStatus @default(DRAFT)
  receivedByUserId String             @map("received_by_user_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lineItems     GoodsReceiptItem[]
  supplierBills SupplierBill[]

  @@unique([companyId, receiptNumber])
  @@index([companyId, purchaseOrderId])
  @@map("goods_receipts")
}

// Folds doc 17's QualityInspection in as a per-line result rather than a separate entity — see
// docs/DOMAIN_MODEL_PHASE5.md. Only PASSED lines feed InventoryBatch/InventoryMovement(RECEIPT)/
// InventoryItem.quantityOnHand.
enum InspectionResult {
  PENDING
  PASSED
  FAILED
}

model GoodsReceiptItem {
  id                  String           @id @default(uuid())
  goodsReceiptId      String           @map("goods_receipt_id")
  purchaseOrderItemId String           @map("purchase_order_item_id")
  quantityReceived    Decimal          @map("quantity_received")
  inspectionResult    InspectionResult @default(PASSED) @map("inspection_result")
  batchNumber         String?          @map("batch_number")
  expiryDate          DateTime?        @map("expiry_date")

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Accounting & Finance (doc 14) — Phase 5
// See docs/DOMAIN_MODEL_PHASE5.md for the double-entry invariant, the money-as-plain-number
// decision, and why Trial Balance/P&L are computed reports rather than stored entities.
// ─────────────────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model ChartOfAccount {
  id          String      @id @default(uuid())
  companyId   String      @map("company_id")
  accountCode String      @map("account_code")
  name        String
  accountType AccountType @map("account_type")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]

  @@unique([companyId, accountCode])
  @@index([companyId, accountType])
  @@map("chart_of_accounts")
}

// sourceType/sourceId (e.g. 'Invoice'|'SupplierBill'|'Manual') is a polymorphic pointer back to
// whatever business event posted this journal — same String-not-enum treatment Document.module
// got, since the set of possible sources grows with the platform, not with this schema.
// JournalService.post() enforces sum(debit) == sum(credit) via domain/journal-balance.ts before
// the row is ever created.
model Journal {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  journalNumber   String   @map("journal_number")
  journalDate     DateTime @map("journal_date")
  memo            String?
  sourceType      String   @map("source_type")
  sourceId        String?  @map("source_id")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   JournalLine[]

  @@unique([companyId, journalNumber])
  @@index([companyId, journalDate])
  @@index([companyId, sourceType, sourceId])
  @@map("journals")
}

model JournalLine {
  id          String   @id @default(uuid())
  journalId   String   @map("journal_id")
  accountId   String   @map("account_id")
  debit       Decimal  @default(0)
  credit      Decimal  @default(0)
  description String?

  journal Journal        @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalId])
  @@index([accountId])
  @@map("journal_lines")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

// One invoice per order (no split invoicing in Phase 5) — generated by
// InvoiceService.generateInvoiceForOrder, the saga's step 3. customerId is denormalized from
// the Order at generation time so AR reports don't need to join back through Order.
model Invoice {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  invoiceNumber String        @map("invoice_number")
  orderId       String        @unique @map("order_id")
  customerId    String        @map("customer_id")
  status        InvoiceStatus @default(ISSUED)
  currency      String
  subtotal      Decimal       @default(0)
  totalAmount   Decimal       @default(0) @map("total_amount")
  amountPaid    Decimal       @default(0) @map("amount_paid")
  issuedAt      DateTime      @default(now()) @map("issued_at")
  dueAt         DateTime?     @map("due_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items   InvoiceItem[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  productId   String   @map("product_id")
  description String?
  quantity    Decimal
  unitPrice   Decimal  @map("unit_price")
  lineTotal   Decimal  @map("line_total")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_items")
}

// entityType/entityId is a genuinely polymorphic pointer (only 'Invoice' is written in Phase 5,
// ready for 'SupplierBill' AP-side vendor payments later without a migration) — deliberately no
// relation/FK on entityId, exactly like ApprovalRequest/InventoryMovement's polymorphism.
model Payment {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id")
  amount          Decimal
  currency        String
  paidAt          DateTime @default(now()) @map("paid_at")
  method          String?
  reference       String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId])
  @@map("payments")
}

enum SupplierBillStatus {
  ISSUED
  PAID
  VOID
}

// Kept minimal — one row, no separate line-item breakout, to control scope (see
// docs/DOMAIN_MODEL_PHASE5.md).
model SupplierBill {
  id              String             @id @default(uuid())
  companyId       String             @map("company_id")
  billNumber      String             @map("bill_number")
  purchaseOrderId String             @map("purchase_order_id")
  supplierId      String             @map("supplier_id")
  goodsReceiptId  String?            @map("goods_receipt_id")
  status          SupplierBillStatus @default(ISSUED)
  currency        String
  totalAmount     Decimal            @default(0) @map("total_amount")
  amountPaid      Decimal            @default(0) @map("amount_paid")
  billDate        DateTime           @default(now()) @map("bill_date")
  dueAt           DateTime?          @map("due_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  goodsReceipt  GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)

  @@unique([companyId, billNumber])
  @@index([companyId, status])
  @@index([companyId, supplierId])
  @@map("supplier_bills")
}

// ─────────────────────────────────────────────────────────────────────────
// AI Core & Agent Framework (docs 05, 18, 26) — Phase 6
// See docs/DOMAIN_MODEL_PHASE6.md for the ratified router/cost-ceiling design, the
// code-defined (not user-authored) Agent/Tool registry, the pause/resume approval state
// machine, and the pgvector-backed vector-search seam finally filled in.
// ─────────────────────────────────────────────────────────────────────────

enum AiProviderKind {
  OPENAI
  ANTHROPIC
  GEMINI
  OLLAMA
}

enum AgentExecutionStatus {
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum ToolExecutionStatus {
  RUNNING
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  REJECTED
}

enum ConversationStatus {
  ACTIVE
  CLOSED
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum MemoryScopeType {
  COMPANY
  CUSTOMER
  USER
  CONVERSATION
  TASK
}

// One row per company per provider it has configured. CompanySettings.aiProvider (Phase 1,
// unused until now) becomes a denormalized "current default provider name" convenience
// pointer that AiProviderConfigService keeps in sync — see docs/DOMAIN_MODEL_PHASE6.md §1.
model AiProviderConfig {
  id                    String         @id @default(uuid())
  companyId             String         @map("company_id")
  provider              AiProviderKind
  enabled               Boolean        @default(true)
  isDefault             Boolean        @default(false) @map("is_default")
  priority              Int            @default(0) @map("priority")
  baseUrl               String?        @map("base_url")
  defaultChatModel      String?        @map("default_chat_model")
  defaultEmbedModel     String?        @map("default_embed_model")
  apiKeyRef             String?        @map("api_key_ref")
  monthlyCostCeilingUsd Decimal?       @map("monthly_cost_ceiling_usd")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId])
  @@map("ai_provider_configs")
}

// Append-only ledger — one row per actual provider call, written by AiRouter itself
// regardless of caller (rule seam, agent tool loop, RAG embedding). Backs both cost-ceiling
// enforcement (SUM(costUsd) over the current period) and observability (provider, tokens,
// latency, cost, success rate) with one mechanism, not two.
model AiUsageRecord {
  id                String         @id @default(uuid())
  companyId         String         @map("company_id")
  provider          AiProviderKind
  model             String
  purpose           String
  promptTokens      Int?           @map("prompt_tokens")
  completionTokens  Int?           @map("completion_tokens")
  totalTokens       Int?           @map("total_tokens")
  costUsd           Decimal        @map("cost_usd")
  latencyMs         Int            @map("latency_ms")
  success           Boolean
  errorMessage      String?        @map("error_message")
  requestedByUserId String?        @map("requested_by_user_id")
  agentExecutionId  String?        @map("agent_execution_id")
  createdAt         DateTime       @default(now()) @map("created_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentExecution AgentExecution? @relation(fields: [agentExecutionId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, provider, createdAt])
  @@map("ai_usage_records")
}

// Mirrors Rule/RuleVersion's two-table versioning shape exactly, and Role.companyId's
// nullable-tenant pattern for platform-wide defaults a company may override. Platform-default
// rows (companyId: null) are written only by a seed script using a raw un-extended
// PrismaClient, read at runtime via withoutTenantScope() — see docs/DOMAIN_MODEL_PHASE6.md §5.
model PromptTemplate {
  id        String   @id @default(uuid())
  companyId String?  @map("company_id")
  key       String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  versions PromptTemplateVersion[]

  @@unique([companyId, key])
  @@map("prompt_templates")
}

model PromptTemplateVersion {
  id               String    @id @default(uuid())
  promptTemplateId String    @map("prompt_template_id")
  version          Int
  content          String
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  promptTemplate PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)

  @@unique([promptTemplateId, version])
  @@map("prompt_template_versions")
}

// Code-defined catalog, mirrored into the DB at boot from packages/ai's static
// AGENT_DEFINITIONS/TOOL_DEFINITIONS registries — NOT tenant-scoped and NOT runtime-editable
// like Rule/Workflow (doc 26's agents are engineering-defined capability bundles, not
// business-user-authored content). Per-company enable/disable reuses the existing
// CompanyFeature model (moduleName = 'ai:<agentKey>') rather than a new join table. See
// docs/DOMAIN_MODEL_PHASE6.md §4.
model Agent {
  id                      String   @id @default(uuid())
  key                     String   @unique
  name                    String
  description             String
  version                 Int      @default(1)
  capabilities            Json
  systemPromptTemplateKey String   @map("system_prompt_template_key")
  isBuiltIn               Boolean  @default(true) @map("is_built_in")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  executions AgentExecution[]

  @@map("agents")
}

model Tool {
  id                       String           @id @default(uuid())
  key                      String           @unique
  name                     String
  description              String
  inputSchema              Json             @map("input_schema")
  requiredPermissionModule String           @map("required_permission_module")
  requiredPermissionAction PermissionAction @map("required_permission_action")
  requiresHumanApproval    Boolean          @default(false) @map("requires_human_approval")
  isBuiltIn                Boolean          @default(true) @map("is_built_in")
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")

  executions ToolExecution[]

  @@map("tools")
}

// Real per-company aggregate — one row per agent invocation. pausedState persists everything
// needed to resume mid-tool-call-loop after a human approval decision — see
// docs/DOMAIN_MODEL_PHASE6.md §10-11 for the pause/resume state machine and why Human Approval
// reuses ApprovalRequest/RuleEvaluationService rather than a second approval system.
model AgentExecution {
  id                String               @id @default(uuid())
  companyId         String               @map("company_id")
  agentId           String               @map("agent_id")
  conversationId    String?              @map("conversation_id")
  requestedByUserId String               @map("requested_by_user_id")
  status            AgentExecutionStatus @default(RUNNING)
  input             Json
  output            Json?
  pausedState       Json?                @map("paused_state")
  errorMessage      String?              @map("error_message")
  totalTokens       Int?                 @map("total_tokens")
  totalCostUsd      Decimal?             @map("total_cost_usd")
  durationMs        Int?                 @map("duration_ms")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Restrict)
  conversation   Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  toolExecutions ToolExecution[]
  usageRecords   AiUsageRecord[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("agent_executions")
}

// Pure child of AgentExecution (no own companyId — reached only via its tenant-scoped parent,
// same shape as OrderLineItem). Independently queryable for "View AI Analytics" via the parent join.
model ToolExecution {
  id                String              @id @default(uuid())
  agentExecutionId  String              @map("agent_execution_id")
  toolId            String              @map("tool_id")
  status            ToolExecutionStatus @default(RUNNING)
  input             Json
  output            Json?
  approvalRequestId String?             @map("approval_request_id")
  errorMessage      String?             @map("error_message")
  durationMs        Int?                @map("duration_ms")
  createdAt         DateTime            @default(now()) @map("created_at")

  agentExecution AgentExecution @relation(fields: [agentExecutionId], references: [id], onDelete: Cascade)
  tool           Tool           @relation(fields: [toolId], references: [id], onDelete: Restrict)

  @@index([agentExecutionId])
  @@map("tool_executions")
}

model Conversation {
  id          String             @id @default(uuid())
  companyId   String             @map("company_id")
  agentId     String?            @map("agent_id")
  subjectType String             @map("subject_type")
  subjectId   String             @map("subject_id")
  title       String?
  status      ConversationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages   ConversationMessage[]
  executions AgentExecution[]

  @@index([companyId, subjectType, subjectId])
  @@map("conversations")
}

model ConversationMessage {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String
  toolName       String?     @map("tool_name")
  toolCallId     String?     @map("tool_call_id")
  tokensUsed     Int?        @map("tokens_used")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_messages")
}

// Company-isolated durable memory (doc 05/26: "never share memory between companies").
model Memory {
  id             String          @id @default(uuid())
  companyId      String          @map("company_id")
  scopeType      MemoryScopeType @map("scope_type")
  scopeId        String?         @map("scope_id")
  key            String
  value          Json
  sourceAgentKey String?         @map("source_agent_key")
  confidence     Float?
  expiresAt      DateTime?       @map("expires_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, scopeType, scopeId, key])
  @@index([companyId, scopeType, scopeId])
  @@map("memories")
}
